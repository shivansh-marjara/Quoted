# Copy to .env in the repo root or in api/. Never commit the copy.

# Prior Labs TabPFN API — required for the real Quote.
# Get a key at https://platform.priorlabs.ai
TABPFN_TOKEN=

# Google AI Studio — Gemma 3 for Brief → Feature Row (and optional WhatsApp prose).
# https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMMA_MODEL=gemma-3-12b-it

# Sentry — optional, used for gen_ai spans.
SENTRY_DSN=
SENTRY_ENVIRONMENT=development

# Comma-separated origins. Leave empty to allow all (demo).
CORS_ORIGINS=
